{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main-capability",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        {
            "identifier": "fs:allow-app-write",
            "allow": [
                {
                    "path": "$HOME/**"
                }
            ]
        },
        {
            "identifier": "shell:allow-open",
            "allow": [
                {
                    "name": "exec-sh",
                    "cmd": "sh",
                    "args": [
                        "-c",
                        {
                            "validator": "\\S+"
                        }
                    ]
                }
            ]
        }
    ]
}