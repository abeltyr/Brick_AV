// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id          String @id @default(cuid())
  name        String
  url         String
  key         String
  contentType String
  previewUrl  String
  previewKey  String
  width       Float
  height      Float
  size        Float

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  company                   Company[]
  vendor                    Vendor[]
  chartOfAccountTransaction ChartOfAccountTransaction[]
}

model Address {
  id          String   @id @default(uuid())
  region      String?
  zone        String?
  woreda      String?
  kebele      String?
  houseNumber String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  Profile  Profile[]
  Business Business[]
}

// User profile data 

model Profile {
  id            String    @id @default(uuid())
  userId        String?   @unique
  name          String?
  preferredName String?
  email         String?
  phoneNumber   String?
  gender        Gender?
  dateBirth     DateTime?
  tin           String?
  addressId     String?
  address       Address?  @relation(fields: [addressId], references: [id])

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  deletedAt                 DateTime?
  companyMember             CompanyMember[]
  chartOfAccountTransaction ChartOfAccountTransaction[]
  chartOfAccount            ChartOfAccount[]
  chartOfAccountBalance     ChartOfAccountBalance[]

  @@index([tin], type: Hash)
}

enum Gender {
  Male
  Female
}

model Business {
  id                    String                 @id @default(uuid())
  tin                   String                 @unique
  legalCondition        BusinessLegalCondition
  registrationNo        String?
  dateRegistered        DateTime?
  businessName          String?
  businessNameAmh       String?
  paidUpCapital         Float?
  managerName           String?
  managerNameEng        String?
  phoneNumber           String?
  phoneNumberAlterative String?

  // location data
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  deletedAt       DateTime?
  businessTrade   BusinessTrade[]
  mrcRegistration MRCRegistration[]
  company         Company[]
  vendor          Vendor[]
}

enum BusinessLegalCondition {
  SoleProprietorship
  GeneralPartnership
  LimitedPartnership
  PrivateLimitedCompany
  ShareCompany
  Cooperative
  JointVenture
  GovernmentEnterprise
  NonProfitOrganization
  ForeignBranch
  LimitedLiabilityPartnership
  PublicEnterprise
  Other
}

model BusinessTrade {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  dateRegistered DateTime?
  tradeName      String?
  tradeNameAmh   String?
  licenseName    String
  licenseCode    String
  licenseNumber  String?
  renewedTo      DateTime?
  renewedFrom    DateTime?
  renewalDate    DateTime?
}

model MRCRegistration {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  mrcNumber  String   @unique
  verified   Boolean
}

model Company {
  id                    String  @id @default(uuid())
  name                  String
  managerName           String?
  email                 String?
  phoneNumber           String?
  phoneNumberAlterative String?
  description           String? @db.Text()

  logoId String?
  logo   File?   @relation(fields: [logoId], references: [id])

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  active                      Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @default(now()) @updatedAt
  deletedAt                   DateTime?
  companyMember               CompanyMember[]
  product                     Product[]
  vendor                      Vendor[]
  purchase                    Purchase[]
  chartOfAccount              ChartOfAccount[]
  fiscalYear                  FiscalYear[]
  chartOfAccountTransaction   ChartOfAccountTransaction[]
  purchaseDailyReport         PurchaseDailyReport[]
  purchaseAccountPeriodReport PurchaseAccountPeriodReport[]
  purchaseFiscalYearReport    PurchaseFiscalYearReport[]
  PurchaseWeeklyReport        PurchaseWeeklyReport[]
}

// Model to track financial periods (e.g., fiscal years)
model FiscalYear {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id])
  year      Int
  startDate DateTime
  endDate   DateTime
  status    FinancialPeriodStatus @default(OPEN) // Indicates if the period is open or closed

  accountBalances          ChartOfAccountBalance[]
  accountPeriods           AccountPeriod[]
  purchaseFiscalYearReport PurchaseFiscalYearReport[]

  @@unique([companyId, year]) // Ensure the company only has one period per year
}

// Model to track financial periods (e.g., fiscal years)
model AccountPeriod {
  id           String     @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])

  name      String?
  order     Int      @default(0)
  startDate DateTime
  endDate   DateTime

  // Ensure the company only has one period per year
  chartOfAccountTransaction   ChartOfAccountTransaction[]
  purchaseAccountPeriodReport PurchaseAccountPeriodReport[]
  PurchaseWeeklyReport        PurchaseWeeklyReport[]

  @@unique([fiscalYearId, startDate, endDate])
  @@unique([fiscalYearId, order])
}

enum ChartOfAccountsType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  OTHER
}

enum ChartOfAccountsCategoryType {
  Account_payable
  Account_receivable
  Accumulated_depreciation
  Cash
  Cost_of_sales
  Equity_does_not_close
  Equity_get_closed
  Equity_retained_earnings
  Expenses
  Fixed_assets
  Income
  Inventory
  Long_term_liabilities
  Other_assets
  Other_current_assets
  Other_current_liabilities
}

model ChartOfAccount {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdById String? // User ID or system identifier
  createdBy   Profile? @relation(fields: [createdById], references: [id])

  type        ChartOfAccountsType // Type: Asset, Liability, etc.
  accountType ChartOfAccountsCategoryType // Sub-category: Account_receivable, Cash, etc.
  name        String
  code        String
  description String?                     @db.Text()
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @default(now()) @updatedAt

  inventory                 Inventory[]
  chartOfAccountBalance     ChartOfAccountBalance?
  chartOfAccountTransaction ChartOfAccountTransaction?

  @@unique([companyId, code]) // Unique company-specific code
  @@index([companyId])
  @@index([type])
}

// Enum for Financial Period Status
enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

model ChartOfAccountBalance {
  id               String         @id @default(cuid())
  chartOfAccountId String         @unique
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  fiscalYearId     String
  fiscalYear       FiscalYear     @relation(fields: [fiscalYearId], references: [id])

  initialBalance Decimal @default(0) // Balance they had when starting
  balance        Decimal @default(0) // Current balance

  statementBalance Decimal? // End of period balance
  clearedBalance   Decimal? // Cleared balance (after reconciliation)
  unclearedBalance Decimal? // Uncleared balance (pending reconciliation)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  creatorId String?
  creator   Profile? @relation(fields: [creatorId], references: [id])
}

enum ChartOfAccountTransactionType {
  INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  TAX
}

enum ChartOfAccountTransactionStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model ChartOfAccountTransaction {
  id                          String                     @id @default(cuid())
  chartOfAccountId            String                     @unique
  chartOfAccount              ChartOfAccount             @relation(fields: [chartOfAccountId], references: [id])
  companyId                   String
  company                     Company                    @relation(fields: [companyId], references: [id])
  chartOfAccountTransactionId String? // Foreign key for the parent transaction
  parentTransaction           ChartOfAccountTransaction? @relation("ParentChildTransaction", fields: [chartOfAccountTransactionId], references: [id]) // Self-referencing relation
  accountPeriodId             String
  accountPeriod               AccountPeriod              @relation(fields: [accountPeriodId], references: [id])

  transactionType   ChartOfAccountTransactionType // Transaction type (invoice, payment, etc.)
  referenceNumber   String? // External reference (e.g., invoice number)
  paymentMethod     String?
  date              DateTime                      @default(now())
  description       String?                       @db.Text() // Description of the transaction
  documentReference String? // External document reference
  referenceFileId   String?
  referenceFile     File?                         @relation(fields: [referenceFileId], references: [id])

  credit       Decimal @default(0)
  debit        Decimal @default(0)
  currency     String  @default("ETB")
  exchangeRate Decimal @default(1)

  isReconciled Boolean                         @default(false) // Reconciliation status
  status       ChartOfAccountTransactionStatus @default(CONFIRMED) // Status (pending, confirmed)
  metadata     Json?

  createdAt   DateTime @default(now())
  createdById String? // User ID or system identifier
  createdBy   Profile? @relation(fields: [createdById], references: [id])

  purchase                 Purchase[]
  vatDetail                VatDetail[]
  totDetail                TotDetail[]
  withholdingDetail        WithholdingDetail[]
  purchaseProduct          PurchaseProduct[]
  parentAccountTransaction ChartOfAccountTransaction[] @relation("ParentChildTransaction")

  @@index([companyId, chartOfAccountId])
}

model CompanyMember {
  id         String            @id @default(uuid())
  profileId  String
  profile    Profile           @relation(fields: [profileId], references: [id])
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id])
  role       CompanyMemberRole
  roleDetail String?
  active     Boolean           @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([profileId, active])
  @@index([companyId, active])
}

enum CompanyMemberRole {
  Owner
  Accountant
  Auditor
  Other
}

enum ProductCategoryType {
  Good
  Service
}

enum ProductUnitType {
  KG
  ML
  GM
  LIT
  MT
  PCS
  CT
  OTHER
  PC
}

enum ProductPurchaseType {
  taxableLocalCapitalAssets
  taxableImportedCapitalAssets
  taxableLocalInputs
  taxableImportedInputs
  taxableGeneralExpenseInputs
  taxExemptedPurchase
}

model Product {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  name         String
  productCode  String
  description  String?             @db.Text()
  type         ProductCategoryType @default(Good)
  purchaseType ProductPurchaseType
  active       Boolean             @default(true)
  purchase     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?
  inventory    Inventory[]

  @@unique([companyId, productCode])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

model Inventory {
  id               String            @id @default(uuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  quantity         Decimal           @default(0)
  lastUpdated      DateTime          @default(now()) @updatedAt
  productPrice     ProductPrice[]
  purchaseProduct  PurchaseProduct[]
  chartOfAccountId String
  chartOfAccount   ChartOfAccount    @relation(fields: [chartOfAccountId], references: [id])
  childInventory   BillOfMaterial[]  @relation("childInventory")
  parentInventory  BillOfMaterial[]  @relation("parentInventory")

  @@index([productId, quantity])
}

model ProductPrice {
  id          String          @id @default(uuid())
  inventoryId String
  inventory   Inventory       @relation(fields: [inventoryId], references: [id])
  active      Boolean         @default(true)
  unit        ProductUnitType
  unitPrice   Decimal
  createdAt   DateTime        @default(now())

  @@index([active, createdAt, inventoryId])
  @@index([inventoryId, unitPrice])
}

model BillOfMaterial {
  id              String    @id @default(uuid())
  parentProductId String
  parentProduct   Inventory @relation("parentInventory", fields: [parentProductId], references: [id])

  childInventoryId String
  childInventory   Inventory @relation("childInventory", fields: [childInventoryId], references: [id])
  quantityRequired Decimal

  @@unique([parentProductId, childInventoryId]) // Ensure a component can only appear once per finished product
  @@index([parentProductId])
}

model Vendor {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  logoId     String?
  logo       File?     @relation(fields: [logoId], references: [id])

  name        String?
  vat         String?
  taxType     TaxType @default(NONE)
  email       String?
  phoneNumber String?
  description String? @db.Text()

  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?
  Purchase  Purchase[]

  @@unique([businessId, companyId])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

enum TaxType {
  VAT
  TOT
  NONE
}

// Invoices or sales
model Purchase {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  vendorId   String
  vendor     Vendor  @relation(fields: [vendorId], references: [id])
  vendorTin  String?
  vendorName String?

  // for the cash payment
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  vatDetailId String?    @unique
  vatDetail   VatDetail? @relation(fields: [vatDetailId], references: [id])

  totDetailId String?    @unique
  totDetail   TotDetail? @relation(fields: [totDetailId], references: [id])

  withholdingDetailId String?            @unique
  withholdingDetail   WithholdingDetail? @relation(fields: [withholdingDetailId], references: [id])

  receiptNumber      String
  cashReceiptVoucher String?
  mrcNumber          String?
  withholdingNumber  String?

  purchaseType ProductPurchaseType
  productType  ProductCategoryType
  description  String              @db.Text()
  quantity     Decimal             @default(0)
  unitPrice    Decimal             @default(0)

  date DateTime

  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalAmount      Decimal @default(0)

  taxAmount         Decimal @default(0)
  withholdingAmount Decimal @default(0)
  grossAmount       Decimal @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  purchaseProducts PurchaseProduct[]

  @@index([date, companyId])
  @@index([vendorId])
  @@index([grossAmount])
}

model PurchaseProduct {
  id                          String                     @id @default(uuid())
  purchaseId                  String
  purchase                    Purchase                   @relation(fields: [purchaseId], references: [id])
  inventoryId                 String
  inventory                   Inventory                  @relation(fields: [inventoryId], references: [id])
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  type         ProductCategoryType
  purchaseType ProductPurchaseType
  unit         ProductUnitType
  unitPrice    Decimal
  quantity     Int
  totalValue   Decimal             @default(0)
  tax          Decimal             @default(0)
  withholding  Decimal             @default(0)
  grossAmount  Decimal             @default(0)
  order        Int                 @default(0)

  @@unique([purchaseId, inventoryId])
  @@index([purchaseId], type: Hash)
  @@index([inventoryId], type: Hash)
}

// VAT Details table
model VatDetail {
  id                          String                     @id @default(uuid())
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  localPurchaseCapitalAssets      Decimal @default(0)
  vatOnLocalPurchaseCapitalAssets Decimal @default(0)
  importedCapitalAssets           Decimal @default(0)
  vatOnImportedCapitalAssets      Decimal @default(0)
  totalCapitalAssets              Decimal @default(0)
  vatOnTotalAssets                Decimal @default(0)

  localPurchaseInputs       Decimal @default(0)
  vatOnLocalPurchaseInputs  Decimal @default(0)
  importedInputs            Decimal @default(0)
  vatOnImportedInputs       Decimal @default(0)
  generalExpenseInputs      Decimal @default(0)
  vatOnGeneralExpenseInputs Decimal @default(0)

  purchaseWithNoVat     Decimal @default(0)
  totalNonCapitalInputs Decimal @default(0)
  vatOnTotalInputs      Decimal @default(0)

  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalAmount      Decimal @default(0)

  taxAmount Decimal @default(0)

  purchase Purchase?
}

// TOT Details table
model TotDetail {
  id                          String                     @id @default(uuid())
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  goodSummaryAmount    Decimal @default(0)
  serviceSummaryAmount Decimal @default(0)
  totalAmount          Decimal @default(0)

  taxAmount Decimal @default(0)

  purchase Purchase?
}

// Withholding Details table
model WithholdingDetail {
  id                          String                     @id @default(uuid())
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  importedGoodSummaryAmount Decimal @default(0)
  importedGoodWithholding   Decimal @default(0)

  localGoodSummaryAmount Decimal @default(0)
  localGoodWithholding   Decimal @default(0)

  serviceSummaryAmount Decimal @default(0)
  serviceWithholding   Decimal @default(0)

  taxableAmount    Decimal @default(0)
  totalWithholding Decimal @default(0)

  purchase Purchase?
}

model PurchaseDailyReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  count     Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalAmount      Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  date DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, companyId])
}

model PurchaseWeeklyReport {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  accountPeriodId String
  accountPeriod   AccountPeriod @relation(fields: [accountPeriodId], references: [id])
  count           Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalAmount      Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountPeriodId, order, companyId])
}

model PurchaseAccountPeriodReport {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  accountPeriodId String
  accountPeriod   AccountPeriod @relation(fields: [accountPeriodId], references: [id])
  count           Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalAmount      Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountPeriodId, companyId])
}

model PurchaseFiscalYearReport {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])

  count Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalAmount      Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fiscalYearId, companyId])
}
