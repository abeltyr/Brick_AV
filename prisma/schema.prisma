// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id          String @id @default(cuid())
  name        String
  url         String
  key         String
  contentType String
  previewUrl  String
  previewKey  String
  width       Float
  height      Float
  size        Float

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  Company                   Company[]
  Vendor                    Vendor[]
  ChartOfAccountTransaction ChartOfAccountTransaction[]
}

model Address {
  id          String   @id @default(uuid())
  region      String?
  zone        String?
  woreda      String?
  kebele      String?
  houseNumber String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  Profile  Profile[]
  Business Business[]
}

// User profile data 

model Profile {
  id            String    @id @default(uuid())
  userId        String?   @unique
  name          String?
  preferredName String?
  email         String?
  phoneNumber   String?
  gender        Gender?
  dateBirth     DateTime?
  tinNumber     String?
  addressId     String?
  address       Address?  @relation(fields: [addressId], references: [id])

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  deletedAt                 DateTime?
  CompanyMember             CompanyMember[]
  ChartOfAccountTransaction ChartOfAccountTransaction[]
  ChartOfAccount            ChartOfAccount[]
  ChartOfAccountBalance     ChartOfAccountBalance[]
  generalLegerCreator       GeneralLedger[]             @relation("GeneralLegerCreator")
  generalLegerUpdater       GeneralLedger[]             @relation("generalLegerUpdater")

  @@index([tinNumber], type: Hash)
}

enum Gender {
  Male
  Female
}

model Business {
  id                    String                 @id @default(uuid())
  tinNumber             String                 @unique
  legalCondition        BusinessLegalCondition
  registrationNo        String?
  dateRegistered        DateTime?
  businessName          String?
  businessNameAmh       String?
  paidUpCapital         Float?
  managerName           String?
  managerNameEng        String?
  phoneNumber           String?
  phoneNumberAlterative String?

  // location data
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  deletedAt       DateTime?
  BusinessTrade   BusinessTrade[]
  MRCRegistration MRCRegistration[]
  Company         Company[]
  Vendor          Vendor[]
}

enum BusinessLegalCondition {
  SoleProprietorship
  GeneralPartnership
  LimitedPartnership
  PrivateLimitedCompany
  ShareCompany
  Cooperative
  JointVenture
  GovernmentEnterprise
  NonProfitOrganization
  ForeignBranch
  LimitedLiabilityPartnership
  PublicEnterprise
  Other
}

model BusinessTrade {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  dateRegistered DateTime?
  tradeName      String?
  tradeNameAmh   String?
  licenseName    String
  licenseCode    String
  licenseNumber  String?
  RenewedTo      DateTime?
  RenewedFrom    DateTime?
  RenewalDate    DateTime?
}

model MRCRegistration {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  MRCNumber  String
  verified   Boolean

  @@unique([businessId, MRCNumber])
}

model Company {
  id                    String  @id @default(uuid())
  name                  String
  managerName           String?
  email                 String?
  phoneNumber           String?
  phoneNumberAlterative String?
  description           String? @db.Text()

  logoId String?
  logo   File?   @relation(fields: [logoId], references: [id])

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  active                    Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  deletedAt                 DateTime?
  CompanyMember             CompanyMember[]
  Product                   Product[]
  Vendor                    Vendor[]
  Purchase                  Purchase[]
  ChartOfAccount            ChartOfAccount[]
  GeneralLedger             GeneralLedger[]
  FinancialPeriod           FinancialPeriod[]
  ChartOfAccountTransaction ChartOfAccountTransaction[]
  DailyPurchaseReport       DailyPurchaseReport[]
  MonthlyPurchaseReport     MonthlyPurchaseReport[]
  YearPurchaseReport        YearPurchaseReport[]
}

// Model to track financial periods (e.g., fiscal years)
model FinancialPeriod {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id])
  year      Int // Year (e.g., 2023)
  startDate DateTime
  endDate   DateTime
  status    FinancialPeriodStatus @default(OPEN) // Indicates if the period is open or closed

  accountBalances ChartOfAccountBalance[]
  GeneralLedger   GeneralLedger[]

  @@unique([companyId, year]) // Ensure the company only has one period per year
}

enum ChartOfAccountsType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  OTHER
}

enum ChartOfAccountsCategoryType {
  Account_payable
  Account_receivable
  Accumulated_depreciation
  Cash
  Cost_of_sales
  Equity_does_not_close
  Equity_get_closed
  Equity_retained_earnings
  Expenses
  Fixed_assets
  Income
  Inventory
  Long_term_liabilities
  Other_assets
  Other_current_assets
  Other_current_liabilities
}

model ChartOfAccount {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdById String? // User ID or system identifier
  createdBy   Profile? @relation(fields: [createdById], references: [id])

  type        ChartOfAccountsType // Type: Asset, Liability, etc.
  category    ChartOfAccountsCategoryType // Sub-category: Account_receivable, Cash, etc.
  name        String
  code        String
  description String?                     @db.Text()
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @default(now()) @updatedAt

  Inventory                 Inventory[]
  Purchase                  Purchase[]
  PurchaseProduct           PurchaseProduct[]
  GeneralLedger             GeneralLedger[]
  ChartOfAccountBalance     ChartOfAccountBalance?
  ChartOfAccountTransaction ChartOfAccountTransaction?
  VatDetail                 VatDetail[]
  TotDetail                 TotDetail[]
  WithholdingDetail         WithholdingDetail[]

  @@unique([companyId, code]) // Unique company-specific code
  @@unique([companyId, name]) // Unique company-specific name
  @@index([companyId])
  @@index([type])
}

// Enum for Financial Period Status
enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

model ChartOfAccountBalance {
  id               String          @id @default(cuid())
  chartOfAccountId String          @unique
  chartOfAccount   ChartOfAccount  @relation(fields: [chartOfAccountId], references: [id])
  periodId         String
  period           FinancialPeriod @relation(fields: [periodId], references: [id])

  initialBalance Decimal @default(0) // Balance they had when starting
  balance        Decimal @default(0) // Current balance

  statementBalance Decimal? // End of period balance
  clearedBalance   Decimal? // Cleared balance (after reconciliation)
  unclearedBalance Decimal? // Uncleared balance (pending reconciliation)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?
}

enum ChartOfAccountTransactionType {
  INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  TRANSFER
}

enum ChartOfAccountTransactionStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model ChartOfAccountTransaction {
  id               String                        @id @default(cuid())
  chartOfAccountId String                        @unique
  chartOfAccount   ChartOfAccount                @relation(fields: [chartOfAccountId], references: [id])
  companyId        String
  company          Company                       @relation(fields: [companyId], references: [id])
  transactionType  ChartOfAccountTransactionType // Transaction type (invoice, payment, etc.)
  referenceId      String? // External reference (e.g., invoice number)

  chartOfAccountTransactionId String?

  credit       Decimal @default(0)
  debit        Decimal @default(0)
  currency     String  @default("ETB")
  exchangeRate Decimal @default(1)

  date              DateTime @default(now())
  description       String?  @db.Text() // Description of the transaction
  documentReference String? // External document reference
  referenceFileId   String?
  referenceFile     File?    @relation(fields: [referenceFileId], references: [id])

  status ChartOfAccountTransactionStatus @default(CONFIRMED) // Status (pending, confirmed)

  metadata      Json? // Flexible metadata
  GeneralLedger GeneralLedger[]

  createdAt         DateTime            @default(now())
  createdById       String? // User ID or system identifier
  createdBy         Profile?            @relation(fields: [createdById], references: [id])
  Purchase          Purchase[]
  VatDetail         VatDetail[]
  TotDetail         TotDetail[]
  WithholdingDetail WithholdingDetail[]
  PurchaseProduct   PurchaseProduct[]

  @@index([companyId, chartOfAccountId])
}

model GeneralLedger {
  id               String                     @id @default(cuid())
  companyId        String
  company          Company                    @relation(fields: [companyId], references: [id])
  chartOfAccountId String
  chartOfAccount   ChartOfAccount             @relation(fields: [chartOfAccountId], references: [id])
  periodId         String
  period           FinancialPeriod            @relation(fields: [periodId], references: [id])
  transactionId    String? // Linked transaction
  transaction      ChartOfAccountTransaction? @relation(fields: [transactionId], references: [id])

  order Int      @default(autoincrement())
  date  DateTime @default(now())

  tableName String?
  tableId   String?

  credit Decimal @default(0)
  debit  Decimal @default(0)

  balanceBefore Decimal @default(0) // Balance after this entry
  balanceAfter  Decimal @default(0) // Balance after this entry
  isReconciled  Boolean @default(false) // Reconciliation status

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String? // User ID or system identifier
  createdBy   Profile? @relation("GeneralLegerCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Profile? @relation("generalLegerUpdater", fields: [updatedById], references: [id])

  @@index([companyId, chartOfAccountId])
}

enum GeneralLedgerTableName {
  Purchase
  PurchaseProduct
  GeneralLedger
}

model CompanyMember {
  id         String            @id @default(uuid())
  profileId  String
  profile    Profile           @relation(fields: [profileId], references: [id])
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id])
  role       CompanyMemberRole
  roleDetail String?
  active     Boolean           @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([profileId, active])
  @@index([companyId, active])
}

enum CompanyMemberRole {
  Owner
  Accountant
  Auditor
  Other
}

enum ProductCategoryType {
  Good
  Service
}

enum ProductUnitType {
  KG
  ML
  GM
  LIT
  MT
  PCS
  CT
  OTHER
  PC
}

enum ProductPurchaseType {
  taxableLocalCapitalAssets
  taxableImportedCapitalAssets
  taxableLocalInputs
  taxableImportedInputs
  taxableGeneralExpenseInputs
  taxExemptedPurchase
}

model Product {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  name         String
  productCode  String
  description  String?             @db.Text()
  type         ProductCategoryType @default(Good)
  purchaseType ProductPurchaseType
  active       Boolean             @default(true)
  purchase     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?
  Inventory    Inventory?

  @@unique([companyId, productCode])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

model Inventory {
  id               String            @id @default(uuid())
  productId        String            @unique
  product          Product           @relation(fields: [productId], references: [id])
  quantity         Int               @default(0)
  lastUpdated      DateTime          @default(now()) @updatedAt
  ProductPrice     ProductPrice[]
  BOM              BOM[]
  PurchaseProduct  PurchaseProduct[]
  chartOfAccountId String
  chartOfAccount   ChartOfAccount    @relation(fields: [chartOfAccountId], references: [id])

  @@index([productId, quantity])
}

model ProductPrice {
  id          String          @id @default(uuid())
  inventoryId String
  inventory   Inventory       @relation(fields: [inventoryId], references: [id])
  active      Boolean         @default(true)
  unit        ProductUnitType
  unitPrice   Decimal
  createdAt   DateTime        @default(now())

  @@index([active, createdAt, inventoryId])
  @@index([inventoryId, unitPrice])
}

model BOM {
  id                         String    @id @default(uuid())
  finishedProductInventoryId String
  initialInventoryId         String
  initialInventory           Inventory @relation(fields: [initialInventoryId], references: [id])
  quantityRequired           Int

  @@unique([finishedProductInventoryId, initialInventoryId]) // Ensure a component can only appear once per finished product
  @@index([finishedProductInventoryId])
}

model Vendor {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  logoId     String?
  logo       File?     @relation(fields: [logoId], references: [id])

  name        String?
  vat         String?
  email       String?
  phoneNumber String?
  vatNumber   String?
  description String? @db.Text()

  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?
  Purchase  Purchase[]

  @@unique([businessId, companyId])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

// Invoices or sales
model Purchase {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])

  // for the cash payment
  chartOfAccountId            String?
  chartOfAccount              ChartOfAccount?            @relation(fields: [chartOfAccountId], references: [id])
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  vatDetailId String?    @unique
  vatDetail   VatDetail? @relation(fields: [vatDetailId], references: [id])

  totDetailId String?    @unique
  totDetail   TotDetail? @relation(fields: [totDetailId], references: [id])

  withholdingDetailId String?            @unique
  withholdingDetail   WithholdingDetail? @relation(fields: [withholdingDetailId], references: [id])

  hasVatDetail         Boolean @default(true)
  hasTotDetail         Boolean @default(false)
  hasWithholdingDetail Boolean @default(true)

  receiptNumber      String
  cashReceiptVoucher String?
  mrcNumber          String?
  withholdingNumber  String?

  purchaseType ProductPurchaseType?
  productType  ProductCategoryType?
  description  String?              @db.Text()
  quantity     Decimal              @default(0)
  unitPrice    Decimal              @default(0)

  date DateTime

  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalBeforeTax   Decimal @default(0)

  taxRate           Int     @default(15)
  taxAmount         Decimal @default(0)
  withholdingAmount Decimal @default(0)
  grossAmount       Decimal @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  purchaseProducts PurchaseProduct[]

  @@index([date, companyId])
  @@index([vendorId])
  @@index([grossAmount])
}

model PurchaseProduct {
  id          String    @id @default(uuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id])
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  // for the expense 
  // for the case of inventory should ask if they want to save it as cost of goods and add it up or as inventory and add it to the beginning of inventory
  chartOfAccountId            String?
  chartOfAccount              ChartOfAccount?            @relation(fields: [chartOfAccountId], references: [id])
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  type         ProductCategoryType
  purchaseType ProductPurchaseType
  unit         ProductUnitType
  unitPrice    Decimal
  quantity     Int
  totalValue   Decimal             @default(0)
  vat          Decimal             @default(0)
  withholding  Decimal             @default(0)
  grossAmount  Decimal             @default(0)
  order        Int                 @default(0)

  @@index([purchaseId], type: Hash)
  @@index([inventoryId], type: Hash)
}

// VAT Details table
model VatDetail {
  id                          String                     @id @default(uuid())
  chartOfAccountId            String?
  chartOfAccount              ChartOfAccount?            @relation(fields: [chartOfAccountId], references: [id])
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  localPurchaseCapitalAssets      Decimal @default(0)
  vatOnLocalPurchaseCapitalAssets Decimal @default(0)
  importedCapitalAssets           Decimal @default(0)
  vatOnImportedCapitalAssets      Decimal @default(0)
  totalCapitalAssets              Decimal @default(0)
  vatOnTotalAssets                Decimal @default(0)

  localPurchaseInputs       Decimal @default(0)
  vatOnLocalPurchaseInputs  Decimal @default(0)
  importedInputs            Decimal @default(0)
  vatOnImportedInputs       Decimal @default(0)
  generalExpenseInputs      Decimal @default(0)
  vatOnGeneralExpenseInputs Decimal @default(0)

  purchaseWithNoVat     Decimal @default(0)
  totalNonCapitalInputs Decimal @default(0)
  vatOnTotalInputs      Decimal @default(0)

  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalBeforeTax   Decimal @default(0)

  taxRate   Int?
  taxAmount Decimal @default(0)

  Purchase Purchase?
}

// TOT Details table
model TotDetail {
  id                          String                     @id @default(uuid())
  chartOfAccountId            String?
  chartOfAccount              ChartOfAccount?            @relation(fields: [chartOfAccountId], references: [id])
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  taxableAmount Decimal
  taxRate       Int?
  taxAmount     Decimal

  Purchase Purchase?
}

// Withholding Details table
model WithholdingDetail {
  id                          String                     @id @default(uuid())
  chartOfAccountId            String?
  chartOfAccount              ChartOfAccount?            @relation(fields: [chartOfAccountId], references: [id])
  chartOfAccountTransactionId String?
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])

  importedGoodSummaryAmount Decimal @default(0)
  importedGoodWithholding   Decimal @default(0)

  localGoodSummaryAmount Decimal @default(0)
  localGoodWithholding   Decimal @default(0)

  serviceSummaryAmount Decimal @default(0)
  serviceWithholding   Decimal @default(0)

  taxableAmount    Decimal @default(0)
  totalWithholding Decimal @default(0)

  Purchase Purchase?
}

model DailyPurchaseReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  count     Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalBeforeTax   Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  date DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, companyId])
}

model MonthlyPurchaseReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  count     Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalBeforeTax   Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  month Int
  year  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year, companyId])
}

model YearPurchaseReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  count     Int

  // General purchase information
  taxableAmount    Decimal @default(0)
  nonTaxableAmount Decimal @default(0)
  totalBeforeTax   Decimal @default(0)

  vatAmount         Decimal? @default(0)
  totAmount         Decimal? @default(0)
  withholdingAmount Decimal  @default(0)
  grossAmount       Decimal  @default(0)

  year Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, companyId])
}
