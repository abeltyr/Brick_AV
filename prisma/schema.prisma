// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Industries {
  identifier      String            @id
  name            String
  CompanyIndustry CompanyIndustry[]
}

model File {
  id          String    @id @default(cuid())
  name        String
  url         String
  key         String
  contentType String
  previewUrl  String
  previewKey  String
  width       Float
  height      Float
  size        Float
  Company     Company[]
}

// Basic Company and user data start
model User {
  id             String           @id @default(uuid())
  name           String
  preferredName  String
  email          String           @unique
  phoneNumber    String?
  gender         Gender?
  dateBirth      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  deletedAt      DateTime?
  Company        Company[]
  Employee       Employee[]
  Sales          Sales[]
  Purchase       Purchase[]
  Withholding    Withholding[]
  EmployeePayout EmployeePayout[]
}

model Company {
  id              String            @id @default(uuid())
  name            String
  legalName       String            @unique
  email           String?
  phoneNumber     String?
  structure       CompanyStructures
  ownerId         String
  user            User              @relation(fields: [ownerId], references: [id])
  logoId          String?
  logo            File?             @relation(fields: [logoId], references: [id])
  tin             String?
  vat             String?
  region          String?
  woreda          String?
  houseNumber     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  deletedAt       DateTime?
  sales           Sales[]
  purchases       Purchase[]
  withholdings    Withholding[]
  employeePayouts EmployeePayout[]
  CompanyIndustry CompanyIndustry[]
  Employee        Employee[]
  CompanyBank     CompanyBank[]

  @@index([ownerId], type: Hash)
}

enum CompanyStructures {
  Plc
  SoloTrading
  Partnership
  Group
  Charity
  Trust
  Other
}

model CompanyIndustry {
  id         String     @id @default(uuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id])
  industries String
  industry   Industries @relation(fields: [industries], references: [identifier])
}

model Employee {
  id                       String                     @id @default(uuid())
  userId                   String
  user                     User                       @relation(fields: [userId], references: [id])
  companyId                String
  company                  Company                    @relation(fields: [companyId], references: [id])
  title                    String?
  hireDate                 DateTime?
  homeAddress              String
  role                     CompanyUserRole
  manager                  Boolean                    @default(false)
  active                   Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  deletedAt                DateTime?
  EmployeeEmergencyContact EmployeeEmergencyContact[]
  EmployeeBank             EmployeeBank[]

  @@index([companyId], type: Hash)
}

model EmployeeEmergencyContact {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String
  order       Int      @default(0)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([employeeId])
}

model EmployeeBank {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  name          String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([employeeId])
}

enum CompanyUserRole {
  Owner
  Accountant
  Receiptor
  Employee
}

enum Gender {
  Male
  Female
}

// Basic Company and user data end

// Bank transactions

model CompanyBank {
  id                      String                    @id @default(uuid())
  companyId               String
  company                 Company                   @relation(fields: [companyId], references: [id])
  name                    String
  accountNumber           String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  CompanyBankTransactions CompanyBankTransactions[]

  @@index([companyId])
}

model CompanyBankTransactions {
  id              String          @id @default(uuid())
  companyBankId   String
  companyBank     CompanyBank     @relation(fields: [companyBankId], references: [id])
  date            DateTime
  description     String?
  amount          Float
  transactionType TransactionType
  accountNumber   String
  category        String
  referenceNumber String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date])
  @@index([companyBankId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  FEE
  REFUND
}

// Invoices or sales

// expense

// report

model Sales {
  id          String    @id @default(uuid())
  creditSales Boolean
  dataIndex   Int
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  amount      Float
  taxAmount   Float
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}

model Purchase {
  id        String    @id @default(uuid())
  dataIndex Int
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  vat       String
  tin       String
  amount    Float
  taxAmount Float
  date      DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}

model Withholding {
  id        String    @id @default(uuid())
  dataIndex Int
  userId    String
  companyId String
  vat       String
  tin       String
  amount    Float
  taxAmount Float
  reason    String
  date      DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}

model EmployeePayout {
  id         String    @id @default(uuid())
  dataIndex  Int
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  employeeId String
  vat        String
  tin        String
  amount     Float
  date       DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}
