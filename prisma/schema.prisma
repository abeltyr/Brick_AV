// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Industries {
  identifier      String            @id
  name            String
  CompanyIndustry CompanyIndustry[]
}

model File {
  id            String          @id @default(cuid())
  name          String
  url           String
  key           String
  contentType   String
  previewUrl    String
  previewKey    String
  width         Float
  height        Float
  size          Float
  Company       Company[]
  Contractor    Contractor[]
  PaymentDetail PaymentDetail[]
}

// User profile data 

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  phoneNumber String?
  name        String
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  CompanyMember CompanyMember[]
  Withholding   Withholding[]
}

model Profile {
  id            String    @id @default(uuid())
  name          String
  preferredName String
  gender        Gender?
  dateBirth     DateTime?
  tinNumber     String?
  addressId     String?
  address       Address?  @relation(fields: [addressId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  Employee   Employee[]
  Contractor Contractor[]
  User       User[]
}

enum Gender {
  Male
  Female
}

model Address {
  id          String    @id @default(uuid())
  region      String?
  city        String?
  woreda      String?
  houseNumber String?
  Company     Company[]
  Profile     Profile[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

// Company related data setup start

model Company {
  id String @id @default(uuid())

  // name and front data
  name        String
  legalName   String            @unique
  email       String?
  phoneNumber String?
  structure   CompanyStructures

  // owner and logo id
  logoId String?
  logo   File?   @relation(fields: [logoId], references: [id])

  // tax based id
  tin String?
  vat String?

  // location data
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  sales                 Sales[]
  purchases             Purchase[]
  withholdings          Withholding[]
  CompanyIndustry       CompanyIndustry[]
  Employee              Employee[]
  CompanyBank           CompanyBank[]
  CompanyMember         CompanyMember[]
  Contractor            Contractor[]
  ContractorPayment     ContractorPayment[]
  EmployeePayment       EmployeePayment[]
  EmployeeIncomeTax     EmployeeIncomeTax[]
  EmployeePension       EmployeePension[]
  ContractorWithholding ContractorWithholding[]
}

model CompanyMember {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  role      CompanyMemberRole
  active    Boolean           @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([userId], type: Hash)
}

enum CompanyMemberRole {
  Owner
  Accountant
}

enum CompanyStructures {
  Plc
  SoloTrading
  Partnership
  Group
  Charity
  Trust
  Other
}

model CompanyIndustry {
  id         String     @id @default(uuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id])
  industries String
  industry   Industries @relation(fields: [industries], references: [identifier])
}

// Company Related Bank transactions and account

model Bank {
  id            String          @id @default(uuid())
  name          String
  uniqueName    String          @unique
  CompanyBank   CompanyBank[]
  EmployeeBank  EmployeeBank[]
  PaymentDetail PaymentDetail[]
}

model CompanyBank {
  id                      String                    @id @default(uuid())
  companyId               String
  company                 Company                   @relation(fields: [companyId], references: [id])
  bankId                  String
  bank                    Bank                      @relation(fields: [bankId], references: [id])
  accountNumber           String?
  type                    CompanyBankType
  CompanyBankTransactions CompanyBankTransactions[]
  BankReconciliation      BankReconciliation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

model BankReconciliation {
  id                 String      @id @default(uuid())
  companyBankId      String
  companyBank        CompanyBank @relation(fields: [companyBankId], references: [id])
  statementBalance   Decimal
  clearedBalance     Decimal
  unclearedBalance   Decimal
  reconciliationDate DateTime
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([companyBankId])
}

enum CompanyBankType {
  Checking
  Saving
}

model CompanyBankTransactions {
  id              String           @id @default(uuid())
  companyBankId   String
  companyBank     CompanyBank      @relation(fields: [companyBankId], references: [id])
  referenceNumber String?
  description     String?          @db.Text()
  amount          Decimal
  credit          Boolean
  date            DateTime
  type            TransactionType?
  category        String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  deletedAt     DateTime?
  PaymentDetail PaymentDetail?

  @@index([date, companyBankId])
  @@index([companyBankId])
}

enum TransactionType {
  DEPOSIT
  SALES
  WITHDRAWAL
  TRANSFER
  PAYMENT
  FEE
  REFUND
}

// Employee related data setup start

model Employee {
  id             String  @id @default(uuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])
  profileId      String
  profile        Profile @relation(fields: [profileId], references: [id])
  title          String?
  role           String?
  jobDescription String?
  active         Boolean @default(true)

  EmployeeEmergencyContact EmployeeEmergencyContact[]
  EmployeeBank             EmployeeBank[]
  EmployeePayroll          EmployeePayroll[]
  EmployeeTimeLine         EmployeeTimeLine[]
  EmployeePayment          EmployeePayment[]
  EmployeeIncomeTax        EmployeeIncomeTax[]
  EmployeePension          EmployeePension[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([companyId], type: Hash)
}

model EmployeeTimeLine {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  hireDate        DateTime  @default(now())
  terminationDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([employeeId], type: Hash)
}

model EmployeeEmergencyContact {
  id           String      @id @default(uuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  name         String
  phoneNumber  String
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  Contractor   Contractor? @relation(fields: [contractorId], references: [id])
  contractorId String?

  @@index([employeeId])
}

model EmployeeBank {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  bankId        String
  bank          Bank     @relation(fields: [bankId], references: [id])
  accountNumber String
  prioryOrder   Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
}

model EmployeePayroll {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // rates
  incomeTaxRate                   Decimal
  employeePensionContributionRate Decimal
  employerPensionContributionRate Decimal

  // amount detail
  grossAmount                 Decimal
  overTime                    Decimal?
  incomeTax                   Decimal
  employeePensionContribution Decimal
  employerPensionContribution Decimal
  costSharing                 Decimal?
  benefit                     Decimal?
  other                       Decimal?
  netPay                      Decimal
  deduction                   Decimal
  total                       Decimal

  payCycle    PayCycle @default(Monthly)
  startDate   DateTime
  endDate     DateTime @default(now())
  paymentDate DateTime

  EmployeeBenefit   EmployeeBenefit[]
  EmployeePayment   EmployeePayment[]
  EmployeeIncomeTax EmployeeIncomeTax[]
  EmployeePension   EmployeePension[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([employeeId], type: Hash)
}

enum PayCycle {
  Weekly
  Biweekly
  Monthly
}

model EmployeeBenefit {
  id                String          @id @default(uuid())
  employeePayrollId String
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id])
  amount            Decimal
  type              BenefitType
  description       String?         @db.Text()

  @@index([employeePayrollId], type: Hash)
}

enum BenefitType {
  MedicalTreatment
  TransportAllowance
  HardshipAllowance
  TourPerDiem
  RecruitmentTravel
  FreeMeals
  GovernmentAllowance
  BoardAllowance
  PensionContribution
  PensionExemption
  GovernmentIncome
  InternationalExemption
  FinancialAidExemption
  Scholarship
  ChildSupport
  NonProfitIncome
  CashIndemnity
  LegalExemption
  DomesticSalary
  PetroleumPayment
}

model PaymentDetail {
  id                        String                   @id @default(uuid())
  paymentDate               DateTime?
  paymentDetail             String?
  bankName                  String?
  bank                      Bank?                    @relation(fields: [bankName], references: [uniqueName])
  accountNumber             String?
  paid                      Boolean                  @default(false)
  recordId                  String?
  record                    File?                    @relation(fields: [recordId], references: [id])
  companyBankTransactionsId String?                  @unique
  companyBankTransactions   CompanyBankTransactions? @relation(fields: [companyBankTransactionsId], references: [id])

  EmployeePayment       EmployeePayment?
  EmployeeIncomeTax     EmployeeIncomeTax?
  EmployeePension       EmployeePension?
  ContractorPayment     ContractorPayment?
  ContractorWithholding ContractorWithholding?
}

model EmployeePayment {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  employeePayrollId String          @unique
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id])
  paymentDetailId   String?         @unique
  paymentDetail     PaymentDetail?  @relation(fields: [paymentDetailId], references: [id])

  netPayAmount Decimal

  month Int
  year  Int

  @@index([month, year, companyId])
  @@index([month, year, employeeId])
}

model EmployeeIncomeTax {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  employeePayrollId String          @unique
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id])
  paymentDetailId   String?         @unique
  paymentDetail     PaymentDetail?  @relation(fields: [paymentDetailId], references: [id])

  amount Decimal
  month  Int
  year   Int

  @@index([month, year, companyId])
  @@index([month, year, employeeId])
}

model EmployeePension {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  employeePayrollId String          @unique
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id])
  paymentDetailId   String?         @unique
  paymentDetail     PaymentDetail?  @relation(fields: [paymentDetailId], references: [id])

  amount Decimal

  month Int
  year  Int

  @@index([month, year, companyId])
  @@index([month, year, employeeId])
}

model Contractor {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  title          String?
  role           String?
  jobDescription String?

  withholdingRate Decimal
  paymentAmount   Decimal
  withholding     Decimal

  grossPayment Decimal

  startDate DateTime  @default(now())
  endDate   DateTime?

  contactId String?
  contact   File?   @relation(fields: [contactId], references: [id])

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  deletedAt                DateTime?
  EmployeeEmergencyContact EmployeeEmergencyContact[]
  ContractorPayment        ContractorPayment[]
  ContractorWithholding    ContractorWithholding[]

  @@index([companyId], type: Hash)
}

model ContractorPayment {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])

  paymentDetailId String?        @unique
  paymentDetail   PaymentDetail? @relation(fields: [paymentDetailId], references: [id])

  netPayAmount Decimal
  month        Int
  year         Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?

  @@index([month, year, companyId])
  @@index([month, year, contractorId])
}

model ContractorWithholding {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])

  paymentDetailId String?        @unique
  paymentDetail   PaymentDetail? @relation(fields: [paymentDetailId], references: [id])

  amount Decimal
  month  Int
  year   Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([month, year, companyId])
  @@index([month, year, contractorId])
}

// Invoices or sales
model Sales {
  id          String    @id @default(uuid())
  creditSales Boolean
  dataIndex   Int
  // userId      String
  // user        User      @relation(fields: [userId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  amount      Float
  taxAmount   Float
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  // @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}

// expense

// report

model Purchase {
  id        String    @id @default(uuid())
  dataIndex Int
  // userId    String
  // user      User      @relation(fields: [userId], references: [id])
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  vat       String
  tin       String
  amount    Float
  taxAmount Float
  date      DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  // @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}

model Withholding {
  id        String    @id @default(uuid())
  dataIndex Int
  userId    String
  companyId String
  vat       String
  tin       String
  amount    Float
  taxAmount Float
  reason    String
  date      DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, dataIndex])
  @@index([companyId, date])
  @@index([companyId, userId])
  @@index([companyId])
  @@index([createdAt])
}
