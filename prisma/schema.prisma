generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id                        String                      @id @default(cuid())
  name                      String
  url                       String
  key                       String
  contentType               String
  previewUrl                String
  previewKey                String
  width                     Float
  height                    Float
  size                      Float
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  chartOfAccountTransaction ChartOfAccountTransaction[]
  company                   Company[]
  vendor                    Vendor[]
}

model Address {
  id          String     @id @default(uuid())
  region      String?
  zone        String?
  woreda      String?
  kebele      String?
  houseNumber String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  Business    Business[]
  Profile     Profile[]
}

model Profile {
  id                        String                      @id @default(uuid())
  userId                    String?                     @unique
  name                      String?
  preferredName             String?
  email                     String?
  phoneNumber               String?
  gender                    Gender?
  dateBirth                 DateTime?
  tin                       String?
  addressId                 String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  deletedAt                 DateTime?
  chartOfAccount            ChartOfAccount[]
  chartOfAccountBalance     ChartOfAccountBalance[]
  chartOfAccountTransaction ChartOfAccountTransaction[]
  companyMember             CompanyMember[]
  address                   Address?                    @relation(fields: [addressId], references: [id])

  @@index([tin], type: Hash)
}

model Business {
  id                    String                 @id @default(uuid())
  tin                   String                 @unique
  legalCondition        BusinessLegalCondition
  registrationNo        String?
  dateRegistered        DateTime?
  businessName          String?
  businessNameAmh       String?
  paidUpCapital         Float?
  managerName           String?
  managerNameEng        String?
  phoneNumber           String?
  phoneNumberAlterative String?
  addressId             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  deletedAt             DateTime?
  address               Address?               @relation(fields: [addressId], references: [id])
  businessTrade         BusinessTrade[]
  company               Company[]
  mrcRegistration       MRCRegistration[]
  vendor                Vendor[]
}

model BusinessTrade {
  id             String    @id @default(uuid())
  businessId     String
  dateRegistered DateTime?
  tradeName      String?
  tradeNameAmh   String?
  licenseName    String
  licenseCode    String
  licenseNumber  String?
  renewedTo      DateTime?
  renewedFrom    DateTime?
  renewalDate    DateTime?
  business       Business  @relation(fields: [businessId], references: [id])
}

model MRCRegistration {
  id         String   @id @default(uuid())
  businessId String
  mrcNumber  String   @unique
  verified   Boolean
  business   Business @relation(fields: [businessId], references: [id])
}

model Company {
  id                          String                        @id @default(uuid())
  name                        String
  managerName                 String?
  email                       String?
  phoneNumber                 String?
  phoneNumberAlterative       String?
  description                 String?
  logoId                      String?
  businessId                  String?
  active                      Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @default(now()) @updatedAt
  deletedAt                   DateTime?
  chartOfAccount              ChartOfAccount[]
  chartOfAccountTransaction   ChartOfAccountTransaction[]
  business                    Business?                     @relation(fields: [businessId], references: [id])
  logo                        File?                         @relation(fields: [logoId], references: [id])
  companyMember               CompanyMember[]
  fiscalYear                  FiscalYear[]
  product                     Product[]
  purchase                    Purchase[]
  purchaseAccountPeriodReport PurchaseAccountPeriodReport[]
  purchaseDailyReport         PurchaseDailyReport[]
  purchaseFiscalYearReport    PurchaseFiscalYearReport[]
  PurchaseWeeklyReport        PurchaseWeeklyReport[]
  vendor                      Vendor[]
}

model FiscalYear {
  id                       String                     @id @default(cuid())
  companyId                String
  year                     Int
  startDate                DateTime
  endDate                  DateTime
  status                   FinancialPeriodStatus      @default(OPEN)
  accountPeriods           AccountPeriod[]
  accountBalances          ChartOfAccountBalance[]
  company                  Company                    @relation(fields: [companyId], references: [id])
  purchaseFiscalYearReport PurchaseFiscalYearReport[]

  @@unique([companyId, year])
}

model AccountPeriod {
  id                          String                        @id @default(cuid())
  fiscalYearId                String
  name                        String?
  order                       Int                           @default(0)
  startDate                   DateTime
  endDate                     DateTime
  fiscalYear                  FiscalYear                    @relation(fields: [fiscalYearId], references: [id])
  AccountingPeriodBalance     AccountingPeriodBalance[]
  chartOfAccountTransaction   ChartOfAccountTransaction[]
  purchaseAccountPeriodReport PurchaseAccountPeriodReport[]
  PurchaseWeeklyReport        PurchaseWeeklyReport[]

  @@unique([fiscalYearId, startDate, endDate])
  @@unique([fiscalYearId, order])
}

model ChartOfAccount {
  id                        String                      @id @default(cuid())
  companyId                 String
  createdById               String?
  type                      ChartOfAccountsType
  accountType               ChartOfAccountsCategoryType
  name                      String
  code                      Int
  description               String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  balanceCreditBased        Boolean                     @default(false)
  accountingPeriodBalance   AccountingPeriodBalance[]
  company                   Company                     @relation(fields: [companyId], references: [id])
  createdBy                 Profile?                    @relation(fields: [createdById], references: [id])
  chartOfAccountBalance     ChartOfAccountBalance[]
  chartOfAccountTransaction ChartOfAccountTransaction[]
  inventory                 Inventory[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type])
}

model ChartOfAccountBalance {
  id               String         @id @default(cuid())
  chartOfAccountId String
  fiscalYearId     String
  initialBalance   Decimal        @default(0)
  balance          Decimal        @default(0)
  statementBalance Decimal?
  clearedBalance   Decimal?
  unclearedBalance Decimal?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  creatorId        String?
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  creator          Profile?       @relation(fields: [creatorId], references: [id])
  fiscalYear       FiscalYear     @relation(fields: [fiscalYearId], references: [id])

  @@unique([chartOfAccountId, fiscalYearId])
}

model AccountingPeriodBalance {
  id               String         @id @default(uuid())
  chartOfAccountId String
  accountPeriodId  String
  openingBalance   Decimal        @default(0)
  closingBalance   Decimal?
  accountPeriod    AccountPeriod  @relation(fields: [accountPeriodId], references: [id])
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])

  @@unique([chartOfAccountId, accountPeriodId])
}

model ChartOfAccountTransaction {
  id                          String                          @id @default(cuid())
  chartOfAccountId            String
  companyId                   String
  chartOfAccountTransactionId String?
  accountPeriodId             String
  transactionType             ChartOfAccountTransactionType
  referenceNumber             String?
  paymentMethod               String?
  date                        DateTime                        @default(now())
  description                 String?
  documentReference           String?
  referenceFileId             String?
  credit                      Decimal                         @default(0)
  debit                       Decimal                         @default(0)
  currency                    String                          @default("ETB")
  exchangeRate                Decimal                         @default(1)
  isReconciled                Boolean                         @default(false)
  status                      ChartOfAccountTransactionStatus @default(CONFIRMED)
  metadata                    Json?
  createdAt                   DateTime                        @default(now())
  createdById                 String?
  transactionSourceId         String?
  transactionSourceTable      String?
  accountPeriod               AccountPeriod                   @relation(fields: [accountPeriodId], references: [id])
  chartOfAccount              ChartOfAccount                  @relation(fields: [chartOfAccountId], references: [id])
  parentTransaction           ChartOfAccountTransaction?      @relation("ParentChildTransaction", fields: [chartOfAccountTransactionId], references: [id])
  parentAccountTransaction    ChartOfAccountTransaction[]     @relation("ParentChildTransaction")
  company                     Company                         @relation(fields: [companyId], references: [id])
  createdBy                   Profile?                        @relation(fields: [createdById], references: [id])
  referenceFile               File?                           @relation(fields: [referenceFileId], references: [id])
  purchase                    Purchase[]

  @@index([companyId, chartOfAccountId])
}

model CompanyMember {
  id         String            @id @default(uuid())
  profileId  String
  companyId  String
  role       CompanyMemberRole
  roleDetail String?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt
  deletedAt  DateTime?
  company    Company           @relation(fields: [companyId], references: [id])
  profile    Profile           @relation(fields: [profileId], references: [id])

  @@index([profileId, active])
  @@index([companyId, active])
}

model Product {
  id           String              @id @default(uuid())
  companyId    String
  name         String
  productCode  String
  description  String?
  type         ProductCategoryType @default(Good)
  purchaseType ProductPurchaseType
  active       Boolean             @default(true)
  purchase     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?
  inventory    Inventory[]
  company      Company             @relation(fields: [companyId], references: [id])

  @@unique([companyId, productCode])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

model Inventory {
  id               String            @id @default(uuid())
  productId        String
  quantity         Float             @default(0)
  lastUpdated      DateTime          @default(now()) @updatedAt
  chartOfAccountId String?
  childInventory   BillOfMaterial[]  @relation("childInventory")
  parentInventory  BillOfMaterial[]  @relation("parentInventory")
  chartOfAccount   ChartOfAccount?   @relation(fields: [chartOfAccountId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  productPrice     ProductPrice[]
  purchaseProduct  PurchaseProduct[]

  @@index([productId, quantity])
}

model ProductPrice {
  id          String          @id @default(uuid())
  inventoryId String
  active      Boolean         @default(true)
  unit        ProductUnitType
  unitPrice   Decimal
  createdAt   DateTime        @default(now())
  inventory   Inventory       @relation(fields: [inventoryId], references: [id])

  @@index([active, createdAt, inventoryId])
  @@index([inventoryId, unitPrice])
}

model BillOfMaterial {
  id               String    @id @default(uuid())
  parentProductId  String
  childInventoryId String
  quantityRequired Float
  childInventory   Inventory @relation("childInventory", fields: [childInventoryId], references: [id])
  parentProduct    Inventory @relation("parentInventory", fields: [parentProductId], references: [id])

  @@unique([parentProductId, childInventoryId])
  @@index([parentProductId])
}

model Vendor {
  id          String     @id @default(uuid())
  companyId   String
  businessId  String?
  logoId      String?
  name        String?
  vat         String?
  taxType     TaxType    @default(NONE)
  email       String?
  phoneNumber String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  deletedAt   DateTime?
  Purchase    Purchase[]
  business    Business?  @relation(fields: [businessId], references: [id])
  company     Company    @relation(fields: [companyId], references: [id])
  logo        File?      @relation(fields: [logoId], references: [id])

  @@unique([businessId, companyId])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

model Purchase {
  id                          String                     @id @default(uuid())
  companyId                   String
  vendorId                    String
  vendorTin                   String?
  vendorName                  String?
  chartOfAccountTransactionId String?
  vatDetailId                 String?                    @unique
  totDetailId                 String?                    @unique
  withholdingDetailId         String?                    @unique
  receiptNumber               String
  mrcNumber                   String?
  withholdingNumber           String?
  purchaseType                ProductPurchaseType
  productType                 ProductCategoryType
  description                 String
  quantity                    Float                      @default(0)
  unitPrice                   Decimal                    @default(0)
  date                        DateTime
  taxableAmount               Decimal                    @default(0)
  nonTaxableAmount            Decimal                    @default(0)
  totalAmount                 Decimal                    @default(0)
  taxAmount                   Decimal                    @default(0)
  withholdingAmount           Decimal                    @default(0)
  grossAmount                 Decimal                    @default(0)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @default(now()) @updatedAt
  deletedAt                   DateTime?
  goodSummaryAmount           Decimal                    @default(0)
  serviceSummaryAmount        Decimal                    @default(0)
  chartOfAccountTransaction   ChartOfAccountTransaction? @relation(fields: [chartOfAccountTransactionId], references: [id])
  company                     Company                    @relation(fields: [companyId], references: [id])
  vatDetail                   VatDetail?                 @relation(fields: [vatDetailId], references: [id])
  vendor                      Vendor                     @relation(fields: [vendorId], references: [id])
  withholdingDetail           WithholdingDetail?         @relation(fields: [withholdingDetailId], references: [id])
  purchaseProducts            PurchaseProduct[]

  @@unique([vendorTin, receiptNumber])
  @@index([date, companyId])
  @@index([vendorId])
  @@index([grossAmount])
}

model PurchaseProduct {
  id           String              @id @default(uuid())
  purchaseId   String
  inventoryId  String
  type         ProductCategoryType
  purchaseType ProductPurchaseType
  unit         ProductUnitType
  unitPrice    Decimal
  quantity     Float
  totalValue   Decimal             @default(0)
  tax          Decimal             @default(0)
  withholding  Decimal             @default(0)
  grossAmount  Decimal             @default(0)
  order        Int                 @default(0)
  inventory    Inventory           @relation(fields: [inventoryId], references: [id])
  purchase     Purchase            @relation(fields: [purchaseId], references: [id])

  @@unique([purchaseId, inventoryId])
  @@index([purchaseId], type: Hash)
  @@index([inventoryId], type: Hash)
}

model VatDetail {
  id                              String    @id @default(uuid())
  localPurchaseCapitalAssets      Decimal   @default(0)
  vatOnLocalPurchaseCapitalAssets Decimal   @default(0)
  importedCapitalAssets           Decimal   @default(0)
  vatOnImportedCapitalAssets      Decimal   @default(0)
  totalCapitalAssets              Decimal   @default(0)
  vatOnTotalAssets                Decimal   @default(0)
  localPurchaseInputs             Decimal   @default(0)
  vatOnLocalPurchaseInputs        Decimal   @default(0)
  importedInputs                  Decimal   @default(0)
  vatOnImportedInputs             Decimal   @default(0)
  generalExpenseInputs            Decimal   @default(0)
  vatOnGeneralExpenseInputs       Decimal   @default(0)
  purchaseWithNoVat               Decimal   @default(0)
  totalNonCapitalInputs           Decimal   @default(0)
  vatOnTotalInputs                Decimal   @default(0)
  taxableAmount                   Decimal   @default(0)
  nonTaxableAmount                Decimal   @default(0)
  totalAmount                     Decimal   @default(0)
  taxAmount                       Decimal   @default(0)
  purchase                        Purchase?
}

model WithholdingDetail {
  id                        String    @id @default(uuid())
  importedGoodSummaryAmount Decimal   @default(0)
  importedGoodWithholding   Decimal   @default(0)
  localGoodSummaryAmount    Decimal   @default(0)
  localGoodWithholding      Decimal   @default(0)
  serviceSummaryAmount      Decimal   @default(0)
  serviceWithholding        Decimal   @default(0)
  taxableAmount             Decimal   @default(0)
  totalWithholding          Decimal   @default(0)
  purchase                  Purchase?
}

model PurchaseDailyReport {
  id                   String   @id @default(uuid())
  companyId            String
  count                Int
  taxableAmount        Decimal  @default(0)
  nonTaxableAmount     Decimal  @default(0)
  goodSummaryAmount    Decimal  @default(0)
  serviceSummaryAmount Decimal  @default(0)
  totalAmount          Decimal  @default(0)
  vatAmount            Decimal? @default(0)
  withholdingAmount    Decimal  @default(0)
  grossAmount          Decimal  @default(0)
  date                 DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id])

  @@unique([date, companyId])
}

model PurchaseWeeklyReport {
  id                   String        @id @default(uuid())
  companyId            String
  accountPeriodId      String
  count                Int
  taxableAmount        Decimal       @default(0)
  nonTaxableAmount     Decimal       @default(0)
  goodSummaryAmount    Decimal       @default(0)
  serviceSummaryAmount Decimal       @default(0)
  totalAmount          Decimal       @default(0)
  vatAmount            Decimal?      @default(0)
  withholdingAmount    Decimal       @default(0)
  grossAmount          Decimal       @default(0)
  order                Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  accountPeriod        AccountPeriod @relation(fields: [accountPeriodId], references: [id])
  company              Company       @relation(fields: [companyId], references: [id])

  @@unique([accountPeriodId, order, companyId])
}

model PurchaseAccountPeriodReport {
  id                   String        @id @default(uuid())
  companyId            String
  accountPeriodId      String
  count                Int
  taxableAmount        Decimal       @default(0)
  nonTaxableAmount     Decimal       @default(0)
  goodSummaryAmount    Decimal       @default(0)
  serviceSummaryAmount Decimal       @default(0)
  totalAmount          Decimal       @default(0)
  vatAmount            Decimal?      @default(0)
  withholdingAmount    Decimal       @default(0)
  grossAmount          Decimal       @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  accountPeriod        AccountPeriod @relation(fields: [accountPeriodId], references: [id])
  company              Company       @relation(fields: [companyId], references: [id])

  @@unique([accountPeriodId, companyId])
}

model PurchaseFiscalYearReport {
  id                   String     @id @default(uuid())
  companyId            String
  fiscalYearId         String
  count                Int
  taxableAmount        Decimal    @default(0)
  nonTaxableAmount     Decimal    @default(0)
  goodSummaryAmount    Decimal    @default(0)
  serviceSummaryAmount Decimal    @default(0)
  totalAmount          Decimal    @default(0)
  vatAmount            Decimal?   @default(0)
  withholdingAmount    Decimal    @default(0)
  grossAmount          Decimal    @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  company              Company    @relation(fields: [companyId], references: [id])
  fiscalYear           FiscalYear @relation(fields: [fiscalYearId], references: [id])

  @@unique([fiscalYearId, companyId])
}

enum Gender {
  Male
  Female
}

enum BusinessLegalCondition {
  SoleProprietorship
  GeneralPartnership
  LimitedPartnership
  PrivateLimitedCompany
  ShareCompany
  Cooperative
  JointVenture
  GovernmentEnterprise
  NonProfitOrganization
  ForeignBranch
  LimitedLiabilityPartnership
  PublicEnterprise
  Other
}

enum ChartOfAccountsType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  OTHER
}

enum ChartOfAccountsCategoryType {
  Account_payable
  Account_receivable
  Accumulated_depreciation
  Cash
  Cost_of_sales
  Equity_does_not_close
  Equity_get_closed
  Equity_retained_earnings
  Expenses
  Fixed_assets
  Income
  Inventory
  Long_term_liabilities
  Other_assets
  Other_current_assets
  Other_current_liabilities
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum ChartOfAccountTransactionType {
  INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  TAX
}

enum ChartOfAccountTransactionStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum CompanyMemberRole {
  Owner
  Accountant
  Auditor
  Other
}

enum ProductCategoryType {
  Good
  Service
}

enum ProductUnitType {
  KG
  ML
  GM
  LIT
  MT
  PCS
  CT
  OTHER
  PC
}

enum ProductPurchaseType {
  taxableLocalCapitalAssets
  taxableImportedCapitalAssets
  taxableLocalInputs
  taxableImportedInputs
  taxableGeneralExpenseInputs
  taxExemptedPurchase
}

enum TaxType {
  VAT
  TOT
  NONE
}
