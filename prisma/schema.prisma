// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id          String @id @default(cuid())
  name        String
  url         String
  key         String
  contentType String
  previewUrl  String
  previewKey  String
  width       Float
  height      Float
  size        Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  Company   Company[]
  Vendor    Vendor[]
}

model Address {
  id          String   @id @default(uuid())
  region      String?
  zone        String?
  woreda      String?
  kebele      String?
  HouseNo     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  Profile       Profile[]
  Business      Business[]
  BusinessTrade BusinessTrade[]
}

// User profile data 

model Profile {
  id            String    @id @default(uuid())
  name          String?
  preferredName String?
  email         String?
  phoneNumber   String?
  gender        Gender?
  dateBirth     DateTime?
  tinNumber     String?
  addressId     String?
  address       Address?  @relation(fields: [addressId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  deletedAt     DateTime?
  CompanyMember CompanyMember[]
  Vendor        Vendor[]

  @@index([tinNumber], type: Hash)
}

enum Gender {
  Male
  Female
}

model Business {
  id              String                 @id @default(uuid())
  tinNumber       String                 @unique
  legalCondition  BusinessLegalCondition
  registrationNo  String?
  dateRegistered  DateTime?
  businessName    String?
  businessNameAmh String?
  paidUpCapital   Float?
  managerName     String?
  managerNameEng  String?

  // location data
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  deletedAt       DateTime?
  BusinessTrade   BusinessTrade[]
  MRCRegistration MRCRegistration[]
  Company         Company[]
  Vendor          Vendor[]
}

enum BusinessLegalCondition {
  SoleProprietorship
  GeneralPartnership
  LimitedPartnership
  PrivateLimitedCompany
  ShareCompany
  Cooperative
  JointVenture
  GovernmentEnterprise
  NonProfitOrganization
  ForeignBranch
  LimitedLiabilityPartnership
  PublicEnterprise
  Other
}

model BusinessTrade {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  dateRegistered DateTime?
  TradeName      String?
  TradeNameAmh   String?
  LicenseNumber  String?
  RenewedTo      DateTime?
  RenewedFrom    DateTime?
  RenewalDate    DateTime?
  licenseName    String

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])
}

model MRCRegistration {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  MRCNumber  String
  verified   Boolean

  @@unique([businessId, MRCNumber])
}

model Company {
  id             String  @id @default(uuid())
  name           String
  managerName    String?
  managerNameEng String?
  email          String?
  phoneNumber    String?
  description    String? @db.Text()

  logoId String?
  logo   File?   @relation(fields: [logoId], references: [id])

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  deletedAt      DateTime?
  CompanyMember  CompanyMember[]
  Product        Product[]
  Vendor         Vendor[]
  Purchase       Purchase[]
  PurchaseReport PurchaseReport[]
}

model CompanyMember {
  id        String            @id @default(uuid())
  profileId String
  profile   Profile           @relation(fields: [profileId], references: [id])
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  role      CompanyMemberRole
  active    Boolean           @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([profileId, active])
  @@index([companyId, active])
}

enum CompanyMemberRole {
  Owner
  Accountant
  Auditor
}

enum ProductCategoryType {
  Good
  Service
}

enum ProductUnitType {
  KG
  ML
  GM
  LIT
  MT
  PCS
  CT
  OTHER
  PC
}

enum ProductPurchaseType {
  taxableLocalCapitalAssets
  taxableImportedCapitalAssets
  taxableLocalInputs
  taxableImportedInputs
  taxableGeneralExpenseInputs
  taxExemptedPurchase
}

model Product {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  name            String
  productCode     String
  description     String?             @db.Text()
  type            ProductCategoryType @default(Good)
  purchaseType    ProductPurchaseType
  active          Boolean             @default(true)
  purchase        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  deletedAt       DateTime?
  Inventory       Inventory?
  PurchaseProduct PurchaseProduct[]

  @@unique([companyId, productCode])
  @@index([companyId], type: Hash)
  @@index([createdAt])
}

model Inventory {
  id           String         @id @default(uuid())
  productId    String         @unique
  product      Product        @relation(fields: [productId], references: [id])
  quantity     Int            @default(0)
  lastUpdated  DateTime       @default(now()) @updatedAt
  ProductPrice ProductPrice[]
  BOM          BOM[]

  @@index([productId, quantity])
}

model ProductPrice {
  id          String          @id @default(uuid())
  inventoryId String
  inventory   Inventory       @relation(fields: [inventoryId], references: [id])
  active      Boolean         @default(true)
  unit        ProductUnitType
  unitPrice   Decimal
  createdAt   DateTime        @default(now())

  @@index([active, createdAt, inventoryId])
  @@index([inventoryId, unitPrice])
}

model BOM {
  id                         String    @id @default(uuid())
  finishedProductInventoryId String
  initialInventoryId         String
  initialInventory           Inventory @relation(fields: [initialInventoryId], references: [id])
  quantityRequired           Int

  @@unique([finishedProductInventoryId, initialInventoryId]) // Ensure a component can only appear once per finished product
  @@index([finishedProductInventoryId])
}

model Vendor {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  logoId     String?
  logo       File?     @relation(fields: [logoId], references: [id])

  name        String
  vat         String?
  contactName String?
  email       String?
  phoneNumber String?
  description String? @db.Text()

  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?
  Purchase  Purchase[]
  Profile   Profile?   @relation(fields: [profileId], references: [id])
  profileId String?

  @@index([companyId], type: Hash)
  @@index([createdAt])
}

// Invoices or sales
model Purchase {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])

  hasVat         Boolean @default(true)
  hasWithholding Boolean @default(true)

  date              DateTime
  VatReceiptNumber  String
  MRCNumber         String?
  withholdingNumber String?
  vendorTin         String?
  vendorVat         String?
  vendorName        String?
  purchaseType      ProductPurchaseType
  productType       ProductCategoryType
  unit              ProductUnitType
  description       String              @db.Text()

  localPurchaseCapitalAssets      Decimal @default(0)
  vatOnLocalPurchaseCapitalAssets Decimal @default(0)

  importedCapitalAssets      Decimal @default(0)
  vatOnImportedCapitalAssets Decimal @default(0)

  totalCapitalAssets Decimal @default(0)
  vatOnTotalAssets   Decimal @default(0)

  localPurchaseInputs      Decimal @default(0)
  vatOnLocalPurchaseInputs Decimal @default(0)

  importedInputs      Decimal @default(0)
  vatOnImportedInputs Decimal @default(0)

  generalExpenseInputs      Decimal @default(0)
  vatOnGeneralExpenseInputs Decimal @default(0)

  purchaseWithNoVat Decimal @default(0)

  totalNonCapitalInputs Decimal @default(0)
  vatOnTotalInputs      Decimal @default(0)

  importedGoodSummaryAmount Decimal @default(0)
  importedGoodWithholding   Decimal @default(0)

  localGoodSummaryAmount Decimal @default(0)
  localGoodWithholding   Decimal @default(0)

  serviceSummaryAmount   Decimal @default(0)
  serviceWithholdingRate Int     @default(2)
  serviceWithholding     Decimal @default(0)

  taxableAmount    Decimal
  nonTaxableAmount Decimal

  totalVat    Decimal
  withholding Decimal

  grossAmount Decimal

  totalQuantity Decimal @default(0)
  averagePrice  Decimal @default(0)

  month Int
  year  Int

  purchaseReportId String?
  purchaseReport   PurchaseReport? @relation(fields: [purchaseReportId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  PurchaseProduct PurchaseProduct[]

  //TODO: Setup the way to link this payment with a bank transaction 
  // paymentDetailId String?        @unique
  // paymentDetail   PaymentDetail? @relation(fields: [paymentDetailId], references: [id])

  @@index([month, year, companyId])
  @@index([month, year, vendorId])
  @@index([purchaseReportId], type: Hash)
}

model PurchaseProduct {
  id           String              @id @default(uuid())
  purchaseId   String
  purchase     Purchase            @relation(fields: [purchaseId], references: [id])
  productId    String
  product      Product             @relation(fields: [productId], references: [id])
  type         ProductCategoryType
  purchaseType ProductPurchaseType
  unit         ProductUnitType
  unitPrice    Decimal
  quantity     Int
  totalValue   Decimal
  vat          Decimal
  grossAmount  Decimal
  order        Int                 @default(0)
  //TODO: add to the chart of account link here

  @@index([purchaseId], type: Hash)
  @@index([productId], type: Hash)
}

model PurchaseReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  count Int

  localPurchaseCapitalAssets      Decimal @default(0)
  vatOnLocalPurchaseCapitalAssets Decimal @default(0)

  importedCapitalAssets      Decimal @default(0)
  vatOnImportedCapitalAssets Decimal @default(0)

  totalCapitalAssets Decimal @default(0)
  vatOnTotalAssets   Decimal @default(0)

  localPurchaseInputs      Decimal @default(0)
  vatOnLocalPurchaseInputs Decimal @default(0)

  importedInputs      Decimal @default(0)
  vatOnImportedInputs Decimal @default(0)

  generalExpenseInputs      Decimal @default(0)
  vatOnGeneralExpenseInputs Decimal @default(0)

  purchaseWithNoVat Decimal @default(0)

  totalNonCapitalInputs Decimal @default(0)
  vatOnTotalInputs      Decimal @default(0)

  deductibleOnVatReverseTaxation      Decimal @default(0)
  vatOnDeductibleOnVatReverseTaxation Decimal @default(0)

  taxAdjustmentsDebitNote      Decimal @default(0)
  vatOnTaxAdjustmentsDebitNote Decimal @default(0)

  taxAdjustmentsCreditNote      Decimal @default(0)
  vatOnTaxAdjustmentsCreditNote Decimal @default(0)

  localGoodSummaryAmount Decimal @default(0)
  localGoodWithholding   Decimal @default(0)

  importedGoodSummaryAmount Decimal @default(0)
  importedGoodWithholding   Decimal @default(0)

  serviceSummaryAmount Decimal @default(0)
  serviceWithholding   Decimal @default(0)

  taxableAmount    Decimal
  nonTaxableAmount Decimal

  totalVat    Decimal
  withholding Decimal

  grossAmount Decimal

  month    Int
  year     Int
  Purchase Purchase[]

  @@unique([month, year, companyId])
}
